# Atlas SaaS Platform - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to version control!

# =============================================================================
# GENERAL SETTINGS
# =============================================================================

# Django Debug Mode (ALWAYS False in production)
DEBUG=False

# Django Secret Key (Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
# CRITICAL: Use a unique, strong secret key for each environment
SECRET_KEY=your-super-secret-key-here-replace-this-value

# Allowed Hosts: comma-separated list of domains/IPs
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================

# PostgreSQL Connection String
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://postgres:your-strong-password@db:5432/atlas_db

# Individual components (for docker-compose)
POSTGRES_DB=atlas_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-password-here

# =============================================================================
# REDIS (Cache & Celery)
# =============================================================================

REDIS_URL=redis://redis:6379/0

# =============================================================================
# STORAGE (MinIO / S3)
# =============================================================================

# Enable S3-compatible storage (True for MinIO/S3, False for local filesystem)
USE_S3=True

# MinIO/S3 Credentials
AWS_ACCESS_KEY_ID=your-minio-access-key
AWS_SECRET_ACCESS_KEY=your-minio-secret-key
AWS_STORAGE_BUCKET_NAME=atlas-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# =============================================================================
# CORS & SECURITY
# =============================================================================

# CORS Allowed Origins: comma-separated URLs
CORS_ALLOWED_ORIGINS=https://your-frontend.com,http://localhost:3005

# CSRF Trusted Origins: comma-separated URLs
CSRF_TRUSTED_ORIGINS=https://your-frontend.com,https://api.your-domain.com,http://localhost:3005,http://localhost:8005

# =============================================================================
# FRONTEND
# =============================================================================

# Public API URL (accessed from user's browser)
NEXT_PUBLIC_API_URL=http://localhost:8005

# Internal API URL (for Next.js SSR, Docker internal communication)
API_URL_INTERNAL=http://backend:8000

# Frontend URL (for emails, redirects, etc.)
FRONTEND_URL=http://localhost:3005

# =============================================================================
# EMAIL (SMTP)
# =============================================================================

# Email Backend: django.core.mail.backends.smtp.EmailBackend (production)
#                django.core.mail.backends.console.EmailBackend (development)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP Server Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# Default "From" email
DEFAULT_FROM_EMAIL=Atlas <noreply@your-domain.com>

# =============================================================================
# WEB PUSH NOTIFICATIONS (VAPID)
# =============================================================================

# Generate VAPID keys with: python -c "from pywebpush import generate_vapid_keys; print(generate_vapid_keys())"
VAPID_PUBLIC_KEY=your-vapid-public-key-here
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_ADMIN_EMAIL=admin@your-domain.com

# =============================================================================
# FIELD ENCRYPTION
# =============================================================================

# Encryption key for sensitive database fields (SMTP passwords, etc.)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-fernet-encryption-key-here

# =============================================================================
# MONITORING & OBSERVABILITY (Optional)
# =============================================================================

# Sentry DSN (for error tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production

# =============================================================================
# AI INTEGRATIONS (Optional)
# =============================================================================

# Google Gemini API Key
# GEMINI_API_KEY=your-gemini-api-key

# OpenAI API Key
# OPENAI_API_KEY=your-openai-api-key

# =============================================================================
# CELERY (Task Queue)
# =============================================================================

# Run tasks synchronously (True for tests, False for production)
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False

# =============================================================================
# HEALTH CHECKS
# =============================================================================

# Ignore Redis in health checks (useful for local dev without Redis)
HEALTH_IGNORE_REDIS=False

# =============================================================================
# CLOUDFLARE TUNNEL
# =============================================================================
TUNNEL_TOKEN=CHANGE_ME_seu_token_aqui_looooongo
