{
  "title": "Atlas — Overview",
  "uid": "atlas-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "HTTP Requests/s",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "rate(django_http_requests_total_by_method_total[1m])",
        "legendFormat": "{{method}}"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP 5xx Errors",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "rate(django_http_responses_total_by_status_total{status=~\"5..\"}[5m])",
        "legendFormat": "5xx/s"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.1 }] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "P95 Latency (ms)",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(django_http_requests_latency_seconds_by_view_method_bucket[5m])) * 1000",
        "legendFormat": "p95"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "unit": "ms" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "DB Connections",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "django_db_new_connections_total",
        "legendFormat": "connections"
      }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request Rate by Status",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(django_http_responses_total_by_status_total[1m])",
        "legendFormat": "{{status}}"
      }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency Percentiles",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(django_http_requests_latency_seconds_by_view_method_bucket[5m])) * 1000", "legendFormat": "p50 (ms)" },
        { "expr": "histogram_quantile(0.95, rate(django_http_requests_latency_seconds_by_view_method_bucket[5m])) * 1000", "legendFormat": "p95 (ms)" },
        { "expr": "histogram_quantile(0.99, rate(django_http_requests_latency_seconds_by_view_method_bucket[5m])) * 1000", "legendFormat": "p99 (ms)" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Cache Hit / Miss Rate",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "rate(django_cache_get_hits_total[1m])", "legendFormat": "hits/s" },
        { "expr": "rate(django_cache_get_misses_total[1m])", "legendFormat": "misses/s" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "DB Query Time",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "expr": "rate(django_db_execute_total[1m])",
        "legendFormat": "queries/s"
      }]
    }
  ]
}
