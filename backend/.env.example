# ═══════════════════════════════════════════════════════════════════
# Atlas — Local Development Environment
# Copy to .env and fill in the values.
# For production secrets, see .env.prod.example at the root.
# ═══════════════════════════════════════════════════════════════════

# ── Django Core ────────────────────────────────────────────────────
DEBUG=True

# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-local-dev-key-CHANGE-THIS-IN-PRODUCTION

ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Database ───────────────────────────────────────────────────────
# Local dev with SQLite (no Docker required):
# DATABASE_URL=sqlite:///db.sqlite3

# Local dev with Postgres (matches docker-compose.dev.yml):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atlas_db

# ── Redis (Cache, Celery, Channels) ────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Security ───────────────────────────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-fernet-key-here

# ── MinIO / S3 Storage ─────────────────────────────────────────────
# Set USE_S3=False to use local filesystem storage in dev (no MinIO needed)
USE_S3=False
# USE_S3=True
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_STORAGE_BUCKET_NAME=atlas-media
# AWS_S3_ENDPOINT_URL=http://localhost:9000
# AWS_S3_REGION_NAME=us-east-1

# ── CORS ───────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3005,http://127.0.0.1:3005

# ── CSRF ───────────────────────────────────────────────────────────
CSRF_TRUSTED_ORIGINS=http://localhost:3005,http://localhost:8000

# ── Frontend URLs ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3005

# ── Email (console backend for dev — no server needed) ────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=localhost
# EMAIL_PORT=1025

# ── Celery ─────────────────────────────────────────────────────────
# In dev, tasks run eagerly (synchronously, no worker needed)
CELERY_TASK_ALWAYS_EAGER=True

# ── Optional: Error Monitoring ─────────────────────────────────────
# Leave empty in dev — Sentry SDK v2+ required if set
SENTRY_DSN=

# ── Optional: AI Features ──────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Optional: Web Push Notifications ──────────────────────────────
# Generate: pywebpush generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@example.com

# ── Health Check ───────────────────────────────────────────────────
# Set to True if Redis is not running locally and you want health check to pass
HEALTH_IGNORE_REDIS=True

# ── Deployment / Production ───────────────────────────────────────
# These are mainly for docker-compose.prod.yml
# APP_VERSION=1.0.0
# REDIS_PASSWORD=highly-secure-password

