# ============================================================
# ATLAS — Production Environment Variables (Cloudflare Tunnel)
# ============================================================
# 1. Copie este arquivo: cp .env.prod.example .env.prod
# 2. Preencha TODOS os valores marcados com CHANGE_ME
# 3. NUNCA faça commit do .env.prod!
# ============================================================

# ── Versão da aplicação ──────────────────────────────────────
APP_VERSION=1.0.0

# ── Django ───────────────────────────────────────────────────
DEBUG=False

# Gere com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=CHANGE_ME_gere_uma_chave_forte_aqui_50_chars

# Chave de criptografia para campos sensíveis (senhas SMTP, etc.)
# Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CHANGE_ME_gere_uma_fernet_key_aqui

# ── Domínio ──────────────────────────────────────────────────
# Substitua api.projetoravenna.cloud e projetoravenna.cloud pelos seus domínios reais
ALLOWED_HOSTS=api.projetoravenna.cloud,atlas.projetoravenna.cloud,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://atlas.projetoravenna.cloud,http://localhost:3005
CSRF_TRUSTED_ORIGINS=https://atlas.projetoravenna.cloud,https://api.projetoravenna.cloud,http://localhost:3005,http://localhost:8005

# ── Database (PostgreSQL) ────────────────────────────────────
POSTGRES_DB=atlas_prod
POSTGRES_USER=atlas_user
POSTGRES_PASSWORD=CHANGE_ME_senha_forte_postgres_aqui

# URL de conexão (deve bater com os dados acima)
DATABASE_URL=postgresql://atlas_user:CHANGE_ME_senha_forte_postgres_aqui@db:5432/atlas_prod

# ── Cache / Broker (Redis) ───────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_senha_forte_redis_aqui
# IMPORTANTE: O ':' antes da senha é obrigatório se o Redis tiver senha
REDIS_URL=redis://:CHANGE_ME_senha_forte_redis_aqui@redis:6379/0

# ── Object Storage (MinIO) ───────────────────────────────────
USE_S3=True
# Credenciais de ADMIN do MinIO (Root)
MINIO_ROOT_USER=CHANGE_ME_usuario_minio_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_senha_minio_16chars_minimo

# Credenciais de acesso S3 (Geralmente as mesmas do Root no MinIO)
AWS_ACCESS_KEY_ID=CHANGE_ME_usuario_minio_admin
AWS_SECRET_ACCESS_KEY=CHANGE_ME_senha_minio_16chars_minimo
AWS_STORAGE_BUCKET_NAME=atlas-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_REGION_NAME=us-east-1

# ── Frontend ─────────────────────────────────────────────────
# URL pública da sua API (com https://)
NEXT_PUBLIC_API_URL=https://api.projetoravenna.cloud
# Comunicação interna container → container (não alterar se usar o docker-compose padrão)
API_URL_INTERNAL=http://atlas_backend:8005
FRONTEND_URL=https://atlas.projetoravenna.cloud

# ── Celery ───────────────────────────────────────────────────
CELERY_CONCURRENCY=2

# ── Email (SMTP) ─────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Atlas <no-reply@projetoravenna.cloud>

# ── Web Push Notifications (Opcional) ───────────────────────
# Gere com: python scripts/generate-secrets.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=admin@projetoravenna.cloud

# ── AI Features (Opcional) ──────────────────────────────────
# Sem chave: IA cai em heurística (ainda funcional)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── MinIO Server URL (Opcional) ─────────────────────────────
# Necessário para gerar URLs públicas corretas (presigned URLs)
# Defina se o MinIO é acessível externamente via domínio próprio
# MINIO_SERVER_URL=https://storage.projetoravenna.cloud

# ── Flower (Celery Monitoring) ───────────────────────────────
# Acessível via Cloudflare Tunnel em 127.0.0.1:5555
FLOWER_USER=admin
FLOWER_PASSWORD=CHANGE_ME_senha_flower_forte

# ── Grafana (Dashboards + Alerting) ─────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_senha_grafana_forte
GRAFANA_ROOT_URL=http://localhost:3001
GRAFANA_ALERT_EMAIL=ops@projetoravenna.cloud
# GRAFANA_SMTP_ENABLED=true   # Descomente para receber alertas por email
# GRAFANA_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── Monitoramento (Opcional) ─────────────────────────────────
SENTRY_DSN=

# ── Licenciamento ────────────────────────────────────────────
LICENSING_ENFORCE=False

# ── Cloudflare Tunnel ───────────────────────────────────────
TUNNEL_TOKEN=CHANGE_ME