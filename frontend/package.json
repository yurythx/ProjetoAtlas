{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "dev:clean": "node scripts/clean-next-artifacts.mjs && next dev -p 3005",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:codegen": "playwright codegen localhost:3005",
    "e2e:report": "playwright show-report e2e/report",
    "schema:export": "cd ../backend && python manage.py spectacular --file docs/schema.yaml --validate",
    "api:generate": "openapi --input src/api/schema.yaml --output src/api/generated --client axios",
    "api:sync": "npm run schema:export && cp ../backend/docs/schema.yaml src/api/schema.yaml && npm run api:generate"
  },
