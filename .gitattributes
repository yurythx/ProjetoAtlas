# ============================================================
# Git Attributes — Atlas
# Garante LF para scripts shell (evita CRLF no Linux)
# ============================================================

# Default: auto-normalize text files
* text=auto

# Shell scripts → SEMPRE LF (nunca CRLF), independente do SO
*.sh text eol=lf

# Python → LF
*.py text eol=lf

# YAML / Docker → LF
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf

# Frontend / TypeScript → LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf

# Binários — sem conversão
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
